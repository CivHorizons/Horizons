$C = "../Common.ui";

$C.@Container {
    Anchor: (Width: 600, Height: 350);

    #Title {
          Group {
            $C.@Title #WelcomeText {
              @Text = "HyUI Container";
            }
          }
        }

        #Content {
          LayoutMode: Top;

          $C.@TextButton {
            @Text = "SoundTech - Owner";
            Anchor: (Top: 5);
          }
        }
}

$C.@BackButton {}