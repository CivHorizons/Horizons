$C = "../../Common.ui";

$C.@PageOverlay {}

$C.@Container {
  Anchor: (Width: 650, Height: 700);

  #Title {
    Group {
      $C.@Title #PageTitle {}
    }
  }

  #Content {
    LayoutMode: Top;

    Label #Status {
      Anchor: (Bottom: 8);
      Style: (TextColor: #ffcc66, Wrap: true);
    }

    Group #Body {
      LayoutMode: Top;
      FlexWeight: 1;

      Label #MembersHeader {
        Style: (RenderBold: true);
        Anchor: (Bottom: 4);
      }

      Group #MemberList {
        FlexWeight: 1;
        LayoutMode: TopScrolling;
        ScrollbarStyle: $C.@DefaultScrollbarStyle;
      }

      Group #InvitesSection {
        LayoutMode: Top;
        Anchor: (Top: 12);

        Label #InvitesHeader {
          Style: (RenderBold: true);
          Anchor: (Bottom: 4);
        }

        Group #InviteList {
          LayoutMode: Top;
        }
      }
    }

    Group {
      LayoutMode: Left;
      Anchor: (Top: 8);

      $C.@SecondaryTextButton #BackButton {
        @Text = "";
      }

      Group {
        FlexWeight: 1;
      }

      Group #ManageButtons {
        LayoutMode: Left;

        $C.@TextButton #InviteButton {
          @Text = "";
          @Anchor = (Right: 6);
        }

        $C.@CancelTextButton #DeleteButton {
          @Text = "";
        }
      }
    }
  }
}
