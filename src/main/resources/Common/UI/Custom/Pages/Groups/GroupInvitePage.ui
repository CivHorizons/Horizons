$C = "../../Common.ui";

$C.@PageOverlay {}

$C.@Container {
  Anchor: (Width: 500, Height: 600);

  #Title {
    Group {
      $C.@Title #PageTitle {}
    }
  }

  #Content {
    LayoutMode: Top;

    Label #Status {
      Anchor: (Bottom: 8);
      Style: (TextColor: #ffcc66, Wrap: true);
    }

    $C.@TextField #SearchInput {
      @Anchor = (Bottom: 8);
    }

    Label #EmptyLabel {
      Style: (TextColor: #ffffff(0.5), Wrap: true);
    }

    Group #PlayerList {
      FlexWeight: 1;
      LayoutMode: TopScrolling;
      ScrollbarStyle: $C.@DefaultScrollbarStyle;
    }

    Group {
      LayoutMode: Left;
      Anchor: (Top: 8);

      $C.@SecondaryTextButton #BackButton {
        @Text = "";
      }
    }
  }
}
